FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o billing-reminder.exe .

FROM alpine:3.19
# chromium dibutuhkan untuk render PDF invoice (dideteksi via CHROME_PATH).
# ca-certificates dan tzdata dipasang agar binary Go & browser berjalan.
RUN apk add --no-cache ca-certificates tzdata chromium
ENV TZ=Asia/Jakarta
ENV CHROME_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=builder /app/billing-reminder.exe .
COPY --from=builder /app/templates ./templates
EXPOSE 8080
CMD ["./billing-reminder.exe"]
